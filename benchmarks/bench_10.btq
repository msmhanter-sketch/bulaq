
функция factorial_loop() { 
    c 0 болсын
    i 0 болсын
    i 1000000 кіші әзірше { 
        f 1 болсын
        j 1 болсын
        j 10 кіші әзірше { f f j көбейту болсын
        j j 1 қосу болсын } 
        c c f қосу болсын
        i i 1 қосу болсын } 
    c қайтару 
}
t1 уақыт() болсын
res factorial_loop() болсын
t2 уақыт() болсын
t2 t1 алу жазу
