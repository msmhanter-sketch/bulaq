
функция pi_approx(n) { 
    s 0.0 болсын
    i 0 болсын
    i n кіші әзірше { 
        div 2 i көбейту 1 қосу болсын
        rem i 2 бөлу 2 көбейту i тең болсын
        rem егер { s s 4.0 div бөлу қосу болсын } әйтпесе { s s 4.0 div бөлу алу болсын } 
        i i 1 қосу болсын } 
    s қайтару 
}
t1 уақыт() болсын
res pi_approx(1000000) болсын
t2 уақыт() болсын
t2 t1 алу жазу
