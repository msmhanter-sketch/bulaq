
функция is_prime(n) { 
    n 2 кіші егер { 0 қайтару } 
    i 2 болсын
    i i көбейту n кіші_немесе_тең әзірше { 
        div n i бөлу болсын
        rem n div i көбейту алу болсын
        rem 0 тең егер { 0 қайтару } 
        i i 1 қосу болсын } 
    1 қайтару 
}
функция prime_count(limit) { 
    c 0 болсын
    i 2 болсын
    i limit кіші әзірше { 
        is_prime(i) 1 тең егер { c c 1 қосу болсын } 
        i i 1 қосу болсын } 
    c қайтару 
}
t1 уақыт() болсын
res prime_count(10000) болсын
t2 уақыт() болсын
t2 t1 алу жазу
