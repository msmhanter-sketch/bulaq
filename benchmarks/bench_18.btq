
функция power_loop(limit) { 
    s 0.0 болсын
    i 0 болсын
    i limit кіші әзірше { 
        p 1.0 болсын
        j 0 болсын
        j 10 кіші әзірше { 
            p p 1.1 көбейту болсын
            j j 1 қосу болсын } 
        s s p қосу болсын
        i i 1 қосу болсын } 
    s қайтару 
}
t1 уақыт() болсын
res power_loop(5000) болсын
t2 уақыт() болсын
t2 t1 алу жазу
