
функция mandelbrot_mock(limit) { 
    c 0 болсын
    x_i 0 болсын
    x_i limit кіші әзірше { 
        y_i 0 болсын
        y_i limit кіші әзірше { 
            zr 0.0 болсын
            zi 0.0 болсын
            j 0 болсын
            j 15 кіші әзірше { 
                zr2 zr zr көбейту zi zi көбейту алу x_i қосу болсын
                zi 2.0 zr көбейту zi көбейту y_i қосу болсын
                zr zr2 болсын
                j j 1 қосу болсын } 
            c c 1 қосу болсын
            y_i y_i 1 қосу болсын } 
        x_i x_i 1 қосу болсын } 
    c қайтару 
}
t1 уақыт() болсын
res mandelbrot_mock(100) болсын
t2 уақыт() болсын
t2 t1 алу жазу
