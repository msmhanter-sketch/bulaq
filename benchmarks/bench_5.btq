
функция boolean_logic() { 
    i 0 болсын
    c 0 болсын
    i 2000000 кіші әзірше { 
        b1 i 2 бөлу 0 тең болсын
        b2 i 3 бөлу 0 тең болсын
        b1 b2 емес және егер { c c 1 қосу болсын } 
        i i 1 қосу болсын } 
    c қайтару 
}
t1 уақыт() болсын
res boolean_logic() болсын
t2 уақыт() болсын
t2 t1 алу жазу
