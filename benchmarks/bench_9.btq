
функция gcd(a, b) { 
    b 0 тең_емес әзірше { 
        div a b бөлу болсын
        rem a div b көбейту алу болсын
        a b болсын
        b rem болсын } 
    a қайтару 
}
функция gcd_loop() { 
    i 0 болсын
    c 0 болсын
    i 2000000 кіші әзірше { c c gcd(12345, i) қосу болсын
    i i 1 қосу болсын } 
    c қайтару 
}
t1 уақыт() болсын
res gcd_loop() болсын
t2 уақыт() болсын
t2 t1 алу жазу
