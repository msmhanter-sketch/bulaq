{
  "name": "butaq-vscode",
  "displayName": "Butaq Language Support",
  "description": "Syntax highlighting and language configuration for the Butaq (Бутақ) programming language.",
  "version": "1.0.0",
  "publisher": "msmhanter-sketch",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "butaq",
        "aliases": [
          "Butaq",
          "butaq"
        ],
        "extensions": [
          ".btq"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "butaq",
        "scopeName": "source.butaq",
        "path": "./syntaxes/butaq.tmLanguage.json"
      }
    ]
  }
}
