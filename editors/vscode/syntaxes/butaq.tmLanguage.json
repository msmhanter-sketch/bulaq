{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Butaq",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#builtins"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifiers"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.number-sign.butaq",
          "match": "#.*$"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.butaq",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.butaq",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.float.butaq",
          "match": "(?<![\\p{L}\\d_])\\d+\\.\\d+(?![\\p{L}\\d_])"
        },
        {
          "name": "constant.numeric.integer.butaq",
          "match": "(?<![\\p{L}\\d_])\\d+(?![\\p{L}\\d_])"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.butaq",
          "match": "(?<![\\p{L}\\d_])(егер|әйтпесе|әзірше|үзу|жалғастыру|қайтару|енгізу)(?![\\p{L}\\d_])"
        },
        {
          "name": "storage.type.function.butaq",
          "match": "(?<![\\p{L}\\d_])(функция)(?![\\p{L}\\d_])"
        },
        {
          "name": "storage.type.struct.butaq",
          "match": "(?<![\\p{L}\\d_])(құрылым)(?![\\p{L}\\d_])"
        },
        {
          "name": "keyword.declaration.butaq",
          "match": "(?<![\\p{L}\\d_])(болсын|жасау|әлсіз|бос|ағын)(?![\\p{L}\\d_])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.butaq",
          "match": "(?<![\\p{L}\\d_])(БҮТІН|САН|МӘТІН|АҚИҚАТ|БАЙТ|тізім)(?![\\p{L}\\d_])"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.butaq",
          "match": "(?<![\\p{L}\\d_])(ақиқат|жалған)(?![\\p{L}\\d_])"
        }
      ]
    },
    "builtins": {
      "patterns": [
        {
          "name": "support.function.builtin.butaq",
          "match": "(?<![\\p{L}\\d_])(жазу|файл_оқу|файл_жазу|кіру|таңба_коды|санды_мәтін|мәтін_тең|ұзындық_жол|біріктіру|символ|тізім_қой|тізім_алу|ұзындық|шақыру)(?![\\p{L}\\d_])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.butaq",
          "match": "(?<![\\p{L}\\d_])(қосу|алу|көбейту|бөлу|үлкен|кіші|тең|тең_емес|үлкен_тең|кіші_тең|және|немесе|емес|жылжыту_сол|жылжыту_оң)(?![\\p{L}\\d_])"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "variable.other.butaq",
          "match": "[\\p{L}_][\\p{L}\\d_]*"
        }
      ]
    }
  },
  "scopeName": "source.butaq"
}
