# Butaq тіліндегі Лексер (Bootstrap Phase)

функция бос_орын_ба(код) {
    код 32 тең егер { 1 қайтару } # space
    код 9 тең егер { 1 қайтару }  # tab
    код 10 тең егер { 1 қайтару } # newline
    код 13 тең егер { 1 қайтару } # carriage return
    0 қайтару
}

функция цифр_ма(код) {
    код 48 үлкен_тең код 57 кіші_тең және егер {
        1 қайтару
    }
    0 қайтару
}

функция әріп_пе(код) {
    # a-z (97-122), A-Z (65-90), _ (95), UTF-8 bytes (>= 127)
    код 97 үлкен_тең код 122 кіші_тең және код 65 үлкен_тең код 90 кіші_тең және немесе код 95 тең немесе код 127 үлкен_тең немесе егер {
        1 қайтару
    }
    0 қайтару
}

функция кілт_сөз_бе(сөз) {
    сөз "болсын" мәтін_тең егер { 1 қайтару }
    сөз "егер" мәтін_тең егер { 1 қайтару }
    сөз "әйтпесе" мәтін_тең егер { 1 қайтару }
    сөз "әзірше" мәтін_тең егер { 1 қайтару }
    сөз "жазу" мәтін_тең егер { 1 қайтару }
    сөз "қосу" мәтін_тең егер { 1 қайтару }
    сөз "алу" мәтін_тең егер { 1 қайтару }
    сөз "көбейту" мәтін_тең егер { 1 қайтару }
    сөз "бөлу" мәтін_тең егер { 1 қайтару }
    сөз "үлкен" мәтін_тең егер { 1 қайтару }
    сөз "кіші" мәтін_тең егер { 1 қайтару }
    сөз "тең" мәтін_тең егер { 1 қайтару }
    сөз "тең_емес" мәтін_тең егер { 1 қайтару }
    сөз "үлкен_тең" мәтін_тең егер { 1 қайтару }
    сөз "кіші_тең" мәтін_тең егер { 1 қайтару }
    сөз "және" мәтін_тең егер { 1 қайтару }
    сөз "немесе" мәтін_тең егер { 1 қайтару }
    сөз "емес" мәтін_тең егер { 1 қайтару }
    сөз "функция" мәтін_тең егер { 1 қайтару }
    сөз "қайтару" мәтін_тең егер { 1 қайтару }
    сөз "шақыру" мәтін_тең егер { 1 қайтару }
    сөз "ақиқат" мәтін_тең егер { 1 қайтару }
    сөз "жалған" мәтін_тең егер { 1 қайтару }
    сөз "символ" мәтін_тең егер { 1 қайтару }
    сөз "біріктіру" мәтін_тең егер { 1 қайтару }
    сөз "ұзындық_жол" мәтін_тең егер { 1 қайтару }
    сөз "мәтін_тең" мәтін_тең егер { 1 қайтару }
    сөз "санды_мәтін" мәтін_тең егер { 1 қайтару }
    сөз "таңба_коды" мәтін_тең егер { 1 қайтару }
    сөз "файл_оқу" мәтін_тең егер { 1 қайтару }
    сөз "файл_жазу" мәтін_тең егер { 1 қайтару }
    0 қайтару
}

функция лексер(мазмұн) {
    "=== Butaq лексері іске қосылды ===" жазу
    
    маз_ұзындық мазмұн ұзындық_жол болсын
    индекс 0 болсын
    
    индекс маз_ұзындық кіші әзірше {
        с мазмұн индекс символ болсын
        код с таңба_коды болсын
        
        бос_па бос_орын_ба(код) болсын
        бос_па 1 тең егер {
            индекс индекс 1 қосу болсын
        } әйтпесе {
            # Comments: '#'
            код 35 тең егер {
                пікір_жалғастыру 1 болсын
                индекс  маз_ұзындық кіші пікір_жалғастыру 1 тең және әзірше {
                    с_ішкі мазмұн индекс символ болсын
                    код_ішкі с_ішкі таңба_коды болсын
                    код_ішкі 10 тең егер {
                        пікір_жалғастыру 0 болсын
                        индекс индекс 1 қосу болсын
                    } әйтпесе {
                        индекс индекс 1 қосу болсын
                    }
                }
            } әйтпесе {
                # Standard Symbols
                код 123 тең егер {
                    "LBRACE: {" жазу
                    индекс индекс 1 қосу болсын
                } әйтпесе { код 125 тең егер {
                    "RBRACE: }" жазу
                    индекс индекс 1 қосу болсын
                } әйтпесе { код 40 тең егер {
                    "LPAREN: (" жазу
                    индекс индекс 1 қосу болсын
                } әйтпесе { код 41 тең егер {
                    "RPAREN: )" жазу
                    индекс индекс 1 қосу болсын
                } әйтпесе { код 44 тең егер {
                    "COMMA: ," жазу
                    индекс индекс 1 қосу болсын
                } әйтпесе { код 91 тең егер {
                    "LBRACKET: [" жазу
                    индекс индекс 1 қосу болсын
                } әйтпесе { код 93 тең егер {
                    "RBRACKET: ]" жазу
                    индекс индекс 1 қосу болсын
                } әйтпесе {
                    # Strings starts with " (34)
                    код 34 тең егер {
                        индекс индекс 1 қосу болсын # skip starting quote
                        жинау "" болсын
                        жол_жалғастыру 1 болсын
                        
                        индекс маз_ұзындық кіші жол_жалғастыру 1 тең және әзірше {
                            с_ішкі мазмұн индекс символ болсын
                            код_ішкі с_ішкі таңба_коды болсын
                            код_ішкі 34 тең егер {
                                жол_жалғастыру 0 болсын
                                индекс индекс 1 қосу болсын
                            } әйтпесе {
                                жинау жинау с_ішкі біріктіру болсын
                                индекс индекс 1 қосу болсын
                            }
                        }
                        "STRING: " жинау біріктіру жазу
                    } әйтпесе {
                        # Digit starts
                        цифр цифр_ма(код) болсын
                        цифр 1 тең егер {
                            жинау "" болсын
                            сан_жалғастыру 1 болсын
                            нүкте_саны 0 болсын
                            
                            индекс маз_ұзындық кіші сан_жалғастыру 1 тең және әзірше {
                                с_ішкі мазмұн индекс символ болсын
                                код_ішкі с_ішкі таңба_коды болсын
                                
                                ішкі_цифр цифр_ма(код_ішкі) болсын
                                ішкі_цифр 1 тең егер {
                                    жинау жинау с_ішкі біріктіру болсын
                                    индекс индекс 1 қосу болсын
                                } әйтпесе { код_ішкі 46 тең егер { # '.'
                                    нүкте_саны нүкте_саны 1 қосу болсын
                                    нүкте_саны 1 үлкен егер {
                                        сан_жалғастыру 0 болсын
                                    } әйтпесе {
                                        жинау жинау с_ішкі біріктіру болсын
                                        индекс индекс 1 қосу болсын
                                    }
                                } әйтпесе {
                                    сан_жалғастыру 0 болсын
                                } }
                            }
                            "NUMBER: " жинау біріктіру жазу
                        } әйтпесе {
                            # Letter / identifier starts
                            әріп әріп_пе(код) болсын
                            әріп 1 тең егер {
                                жинау "" болсын
                                әріп_жалғастыру 1 болсын
                                
                                индекс маз_ұзындық кіші әріп_жалғастыру 1 тең және әзірше {
                                    с_ішкі мазмұн индекс символ болсын
                                    код_ішкі с_ішкі таңба_коды болсын
                                    
                                    ішкі_цифр цифр_ма(код_ішкі) болсын
                                    ішкі_әріп әріп_пе(код_ішкі) болсын
                                    
                                    ішкі_цифр 1 тең ішкі_әріп 1 тең немесе егер {
                                        жинау жинау с_ішкі біріктіру болсын
                                        индекс индекс 1 қосу болсын
                                    } әйтпесе {
                                        әріп_жалғастыру 0 болсын
                                    }
                                }
                                
                                кілт кілт_сөз_бе(жинау) болсын
                                кілт 1 тең егер {
                                    "KEYWORD: " жинау біріктіру жазу
                                } әйтпесе {
                                    "IDENTIFIER: " жинау біріктіру жазу
                                }
                            } әйтпесе {
                                # Illegal character
                                "ILLEGAL: " с біріктіру жазу
                                индекс индекс 1 қосу болсын
                            }
                        }
                    }
                } } } } } } }
            }
        }
    }
}

# Main Execution
мазмұн "examples/math.btq" файл_оқу болсын
лексер(мазмұн)
