# ─── 4. Функциялар ────────────────────────────────────────────
"" жазу
"[4] Рекурсия: Фибоначчи" жазу

функция фиб (n) {
    n 1 кіші_тең егер {
        n қайтару
    }
    фиб (n 1 алу) фиб (n 2 алу) қосу қайтару
}

i 0 болсын
"fib(0..9): " жазу
i 10 кіші әзірше {
    фиб (i) жазу
    i i 1 қосу болсын
}

# ─── 5. Құрылымдар ────────────────────────────────────────────
"" жазу
"[5] Құрылымдар (OOP стилі)" жазу

құрылым Студент {
    аты МӘТІН
    баға САН
    курс БҮТІН
}

функция бағалау (студент) {
    студент.баға 90 үлкен_тең егер {
        "А (Үздік)" қайтару
    } әйтпесе {
        студент.баға 75 үлкен_тең егер {
            "В (Жақсы)" қайтару
        } әйтпесе {
            "С (Орташа)" қайтару
        }
    }
}

с1 Студент жасау болсын
с1.аты "Жансая" болсын
с1.баға 95.0 болсын
с1.курс 3 болсын

"Студент: " жазу
с1.аты жазу
"Баға   : " жазу
с1.баға жазу
"Бағалау: " жазу
бағалау (с1) жазу

# ─── 6. Массивтер ─────────────────────────────────────────────
"" жазу
"[6] Массивтер және сұрыптау (Bubble Sort)" жазу

массив [64, 34, 25, 12, 22, 11, 90] болсын

# Bubble Sort
n 7 болсын
i 0 болсын
i n 1 алу кіші әзірше {
    j 0 болсын
    j n i алу 1 алу кіші әзірше {
        а массив j тізім_алу болсын
        б массив j 1 қосу тізім_алу болсын
        а б үлкен егер {
            массив j б тізім_қой
            массив j 1 қосу а тізім_қой
        }
        j j 1 қосу болсын
    }
    i i 1 қосу болсын
}

"Сұрыпталған: " жазу
k 0 болсын
k 7 кіші әзірше {
    массив k тізім_алу жазу
    k k 1 қосу болсын
}

