# else-if nested style тестілеу (existing approach)

сан 42 болсын

сан 0 кіші егер {
    "Теріс сан" жазу
} әйтпесе {
    сан 0 тең егер {
        "Нөл" жазу
    } әйтпесе {
        сан 10 кіші егер {
            "1-9 аралығы" жазу
        } әйтпесе {
            сан 100 кіші егер {
                "10-99 аралығы" жазу
            } әйтпесе {
                "100 немесе одан үлкен" жазу
            }
        }
    }
}
