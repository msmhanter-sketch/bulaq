# Тест: Қателерді өңдеу (Error Handling Test)

функция бөл(а, б) {
    б 0.0 тең егер {
        "нөлге бөлуге болмайды" қате қайтару
    }
    а б бөлу қайтару
}

функция сәлемдесу(есім) {
    есім "" мәтін_тең егер {
        "есім бос болмауы керек" қате қайтару
    }
    "Сәлем, " есім біріктіру қайтару
}

# 1. Сәтті бөлу
сан1 бөл(10.0, 2.0) қатемен қате_хабар {
    "Қате орын алды: " қате_хабар біріктіру жазу
    0.0
} болсын
"Бөлу 10/2 нәтижесі: " жазу
сан1 жазу

# 2. Қатемен бөлу
сан2 бөл(10.0, 0.0) қатемен қате_хабар {
    "Қате орын алды: " қате_хабар біріктіру жазу
    0.0 1.0 алу
} болсын
"Бөлу 10/0 нәтижесі: " жазу
сан2 жазу

# 3. Сәтті мәтін
сәлем1 сәлемдесу("Әли") қатемен қате_хабар {
    "Қате орын алды: " қате_хабар біріктіру жазу
    "дефолт"
} болсын
"Мәтін 1: " жазу
сәлем1 жазу

# 4. Қате мәтін
сәлем2 сәлемдесу("") қатемен қате_хабар {
    "Қате орын алды: " қате_хабар біріктіру жазу
    "дефолт"
} болсын
"Мәтін 2: " жазу
сәлем2 жазу
