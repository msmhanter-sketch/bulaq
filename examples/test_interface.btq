"--- Интерфейсті тестілеу ---" жазу

интерфейс ДыбысШығарғыш {
    дыбыс_шығару() МӘТІН
}

құрылым Ит {
    аты МӘТІН
}

функция Ит.дыбыс_шығару(өзі) {
    "Ау-ау!" қайтару
}

құрылым Мысық {
    аты МӘТІН
}

функция Мысық.дыбыс_шығару(өзі) {
    "Мияу!" қайтару
}

# 1. Объектілерді құру
ит Ит("Төбет") болсын
мысық Мысық("Маруся") болсын

# 2. Интерфейс айнымалыларына тағайындау
д1 ДыбысШығарғыш(ит) болсын
д2 ДыбысШығарғыш(мысық) болсын

# 3. Динамикалық методтарды шақыру
"Ит дыбысы: " жазу
д1.дыбыс_шығару() жазу

"Мысық дыбысы: " жазу
д2.дыбыс_шығару() жазу

ит бос
мысық бос
д1 бос
д2 бос

"--- Аяқталды ---" жазу
