"--- Цикл тестілеу (үзу және жалғастыру) ---" жазу
x 0 болсын
x 10 кіші әзірше {
    x x 1 қосу болсын
    
    # x == 3 болса, жалғастыру (skip)
    x 3 тең егер {
        жалғастыру
    }
    
    # x == 7 болса, үзу (break)
    x 7 тең егер {
        үзу
    }
    
    x жазу
}
"--- Аяқталды ---" жазу
