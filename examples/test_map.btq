# Тест: Словарь (Map)
байлар сөздік_жаңа() болсын

# Добавляем числа
сөздік_сан_қою(байлар, "Әлихан", 1000000.0) шақыру
сөздік_сан_қою(байлар, "Берік", 500000.0) шақыру
сөздік_сан_қою(байлар, "Ғалым", 750000.0) шақыру

# Получаем значения
сөздік_сан_алу(байлар, "Әлихан") жазу
сөздік_сан_алу(байлар, "Берік") жазу

# Проверяем наличие ключа
сөздік_бар_ма(байлар, "Ғалым") жазу
сөздік_бар_ма(байлар, "Мейрам") жазу

# Размер словаря
сөздік_өлшемі(байлар) жазу

# Удаляем ключ
сөздік_жою(байлар, "Берік") шақыру
сөздік_өлшемі(байлар) жазу
сөздік_бар_ма(байлар, "Берік") жазу

# Строковые значения
қала сөздік_жаңа() болсын
сөздік_мәтін_қою(қала, "астана", "Астана қ.") шақыру
сөздік_мәтін_қою(қала, "алматы", "Алматы қ.") шақыру
сөздік_мәтін_алу(қала, "астана") жазу
сөздік_мәтін_алу(қала, "алматы") жазу
