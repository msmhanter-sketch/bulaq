"--- Құрылым әдістері (ООП) тесті ---" жазу

құрылым Адам {
    аты МӘТІН
    жасы САН
}

функция Адам.таныстыру(өзі) {
    "Сәлем, менің атым: " жазу
    өзі.аты жазу
    "Жасым: " жазу
    өзі.жасы жазу
}

# Адам құрылымын жасап, әдісін шақырамыз
әли Адам("Әли", 25) болсын
әли.таныстыру()

әли бос
"--- Тест аяқталды ---" жазу
