"--- Құрылым әдістерін тестілеу (ООП) ---" жазу

құрылым Адам {
    аты МӘТІН
    жасы БҮТІН
}

функция Адам.таныстыру(өзі) {
    "Менің атым: " жазу
    өзі.аты жазу
    "Жасым: " жазу
    өзі.жасы жазу
}

функция Адам.жас_қосу(өзі, жылдар) {
    өзі.жасы өзі.жасы жылдар қосу болсын
}

# 1. Объект жасау
adam Адам жасау болсын
adam.аты "Әли" болсын
adam.жасы 25 болсын

# 2. Метод шақыру
adam.таныстыру() шақыру

# 3. Мән өзгерту әдісі
"--- 5 жыл өтті ---" жазу
adam.жас_қосу(5) шақыру

# 4. Қайта тексеру
adam.таныстыру() шақыру

# 5. Босату
adam бос

"--- Аяқталды ---" жазу
