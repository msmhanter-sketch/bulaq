"--- Қауіпсіздік тесті (Runtime Safety) ---" жазу

құрылым Адам {
    аты МӘТІН
}

# Тестілеу түрі:
# 1 - Division by Zero (нөлге бөлу)
# 2 - Null Pointer Dereference (бос сілтеме)
# 3 - Array Out of Bounds (жиын шекарасы)
тест_түрі 3 болсын

тест_түрі 1 тең егер {
    "1. Нөлге бөлуді тексеру..." жазу
    а 10 болсын
    б 0 болсын
    c а б бөлу болсын
    c жазу
}

тест_түрі 2 тең егер {
    "2. Бос сілтемені (null pointer) тексеру..." жазу
    
    adam Адам жасау болсын
    adam 0 болсын # null-ға теңестіру
    adam.аты "Әли" болсын
}

тест_түрі 3 тең егер {
    "3. Жиын шекарасынан шығуды тексеру..." жазу
    массив [10, 20, 30] болсын
    
    # Тізім өлшемі 3. Индекстері: 0, 1, 2.
    # Біз 5-інші индексті оқуға тырысамыз:
    x массив 5 тізім_алу болсын
    x жазу
}

"--- Аяқталды ---" жазу
