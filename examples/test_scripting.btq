"--- Жүйелік скрипт мүмкіндіктерін тестілеу ---" жазу

# 1. Аргументтерді тексеру
"Аргументтер саны:" жазу
саны аргумент_саны() болсын
саны жазу

"Барлық аргументтер:" жазу
икс 0 болсын
икс саны кіші әзірше {
    арг аргумент(икс) болсын
    арг жазу
    икс икс 1 қосу болсын
}

# 2. Файлмен жұмыс (жазу, оқу, бар_ма, жою)
файл "temp_test_script.txt" болсын

"Файл бастапқыда бар ма?" жазу
бар_ма файл_бар_ма(файл) болсын
бар_ма жазу

"Файлға жазу..." жазу
файл "Бұл Butaq тілінің жүйелік скрипті!" файл_жазу

"Файл жазылғаннан кейін бар ма?" жазу
бар_ма файл_бар_ма(файл) болсын
бар_ма жазу

"Файл мазмұны:" жазу
мазмұн файл файл_оқу болсын
мазмұн жазу

"Файлды жою..." жазу
өшіру файл_жою(файл) болсын
өшіру жазу

"Файл өшірілгеннен кейін бар ма?" жазу
бар_ма файл_бар_ма(файл) болсын
бар_ма жазу

# 3. Жүйелік команданы орындау
"Жүйелік команданы іске қосу (жүйе)..." жазу
код жүйе("echo 'Сәлем Жүйеден!'") болсын
"Орындау коды:" жазу
код жазу

"--- Тест аяқталды ---" жазу
