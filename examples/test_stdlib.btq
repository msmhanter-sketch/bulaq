"--- Butaq стандартты кітапханасын тестілеу ---" жазу

# 1. Криптографиялық функцияларды тексеру
"1. Криптография және Base64:" жазу
мәтін "Сәлем, Әлем!" болсын

х_мд5 мд5(мәтін) болсын
"MD5 ('Сәлем, Әлем!'):" жазу
х_мд5 жазу

х_ша256 ша256(мәтін) болсын
"SHA-256 ('Сәлем, Әлем!'):" жазу
х_ша256 жазу

кодталған б64_кодтау(мәтін) болсын
"Base64 кодталған:" жазу
кодталған жазу

декодталған б64_декодтау(кодталған) болсын
"Base64 декодталған:" жазу
декодталған жазу


# 2. JSON өңдеуді тексеру
"2. JSON өңдеу:" жазу
объект жсон_жаңа() болсын
жсон_сан_қосу(объект, "нұсқасы", 1.0)
жсон_мәтін_қосу(объект, "аты", "Butaq")
жсон_логика_қосу(объект, "белсенді", ақиқат)

ішкі_объект жсон_жаңа() болсын
жсон_мәтін_қосу(ішкі_объект, "тіл", "қазақ")
жсон_нысан_қосу(объект, "мәлімет", ішкі_объект)

json_str жсон_жазу(объект) болсын
"JSON жазылуы:" жазу
json_str жазу

# JSON оқу және мәлімет алу
оқылған жсон_оқу(json_str) болсын
"Оқылған аты:" жазу
жсон_мәтін_алу(оқылған, "аты") жазу

"Оқылған нұсқасы:" жазу
жсон_сан_алу(оқылған, "нұсқасы") жазу

"Оқылған белсенді:" жазу
жсон_логика_алу(оқылған, "белсенді") жазу

"Оқылған ішкі мәлімет тілі:" жазу
ішкі жсон_нысан_алу(оқылған, "мәлімет") болсын
жсон_мәтін_алу(ішкі, "тіл") жазу


# 3. Көп ағындылықты (Threading) тексеру
"3. Көп ағындылық (Threads):" жазу

түйін ағын {
    "  [Ағын] Басталды!" жазу
    # кішігірім кідіріс немесе жұмыс имитациясы
    i 0 болсын
    i 100000 кіші әзірше {
        i i 1 қосу болсын
    }
    "  [Ағын] Аяқталды!" жазу
} болсын

"Негізгі ағын: Ағын іске қосылды, күтілуде..." жазу
ағын_күту(түйін)
"Негізгі ағын: Ағын аяқталды!" жазу


# 4. Әлсіз сілтемелерді (Weak References) тексеру
"4. Әлсіз сілтемелер (Weak References):" жазу

құрылым Торап {
    аты МӘТІН
    көрші әлсіз Торап
}

торап1 Торап жасау болсын
торап1.аты "Торап 1" болсын

торап2 Торап жасау болсын
торап2.аты "Торап 2" болсын

# Циклдік емес, әлсіз сілтеме орнату
торап1.көрші торап2 болсын

"Торап 1 көршісінің аты:" жазу
көрші торап1.көрші болсын
көрші.аты жазу

# Торап 2-ні жоямыз (сілтемесін 0 қыламыз)
"Торап 2 жойылуда..." жазу
торап2 0 болсын

# Торап 1-дің көршісі автоматты түрде нөл (0) болуы керек!
тексеру торап1.көрші болсын
тексеру 0 тең егер {
    "Сәтті: Әлсіз сілтеме автоматты түрде нөлге (0) айналды!" жазу
} әйтпесе {
    "ҚАТЕ: Әлсіз сілтеме нөлденбеді!" жазу
}

"--- Барлығы сәтті аяқталды ---" жазу
