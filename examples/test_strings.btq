# Тест: Строковые функции
жол "Сәлем, Дүние! Butaq тілі." болсын

# мәтін_кіші / мәтін_жоғары
мәтін_кіші(жол) жазу
мәтін_жоғары(жол) жазу

# мәтін_іздеу
мәтін_іздеу(жол, "Butaq") жазу

# мәтін_басталады / мәтін_аяқталады
мәтін_басталады(жол, "Сәлем") жазу
мәтін_аяқталады(жол, "тілі.") жазу

# мәтін_ауыстыру
мәтін_ауыстыру(жол, "Дүние", "Әлем") жазу

# мәтін_бөлу
бөлінген "Алма,Алматы,Қазақстан" болсын
мәтін_бөлу(бөлінген, ",", 0) жазу
мәтін_бөлу(бөлінген, ",", 1) жазу
мәтін_бөлу(бөлінген, ",", 2) жазу
мәтін_бөлу_саны(бөлінген, ",") жазу

# мәтін_кесу
мәтін_кесу(жол, 7, 13) жазу

# мәтін_қысқарту
керемет "   буйрыксыз   " болсын
мәтін_қысқарту(керемет) жазу
