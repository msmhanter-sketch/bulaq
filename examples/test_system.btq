"--- Жүйелік және уақыт функцияларын тестілеу ---" жазу

# 1. Ағымдағы уақытты алу (уақыт)
t  уақыт() болсын
"Ағымдағы Unix уақыты (секундпен):" жазу
t жазу

# 2. Пішімделген уақытты алу (уақыт_мәтіні)
# Мысалы: ЖЖЖЖ-АА-КК СС:ММ:СС
fmt_str "%Y-%m-%d %H:%M:%S" болсын
t_str  уақыт_мәтіні(fmt_str) болсын
"Пішімделген ағымдағы уақыт:" жазу
t_str жазу

# 3. Жүйелік команданың шығысын алу (жүйе_шығысы)
cmd "echo Hello from Butaq runtime popen system!" болсын
out_str  жүйе_шығысы(cmd) болсын
"Команданың қайтарған мәні:" жазу
out_str жазу

"--- Тест аяқталды ---" жазу
