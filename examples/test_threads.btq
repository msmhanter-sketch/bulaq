# Тест: Многопоточность и Мьютексы (Threading & Mutexes)

счетчик 0 болсын
лок мьютекс_жаңа() болсын

"Ағындарды іске қосу..." жазу

ағын1 ағын {
    "  [Ағын 1] Басталды" жазу
    i 0 болсын
    i 50000 кіші әзірше {
        мьютекс_бекіту(лок) шақыру
        счетчик счетчик 1 қосу болсын
        мьютекс_босату(лок) шақыру
        i i 1 қосу болсын
    }
    "  [Ағын 1] Аяқталды" жазу
} болсын

ағын2 ағын {
    "  [Ағын 2] Басталды" жазу
    j 0 болсын
    j 50000 кіші әзірше {
        мьютекс_бекіту(лок) шақыру
        счетчик счетчик 1 қосу болсын
        мьютекс_босату(лок) шақыру
        j j 1 қосу болсын
    }
    "  [Ағын 2] Аяқталды" жазу
} болсын

# Күтеміз
ағын_күту(ағын1)
ағын_күту(ағын2)

"Счетчик мәні (күтілетін 100000):" жазу
счетчик жазу

мьютекс_жою(лок) шақыру
