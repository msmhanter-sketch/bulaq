# Қарапайым сәлемдесу бағдарламасы
жазу "Сәлем, Әлем!"

айнымалы x = 10
айнымалы y = 20

айнымалы қосынды = x + y

жазу "x + y ="
жазу қосынды

егер қосынды > 20 {
    жазу "Қосынды 20-дан үлкен"
} әйтпесе {
    жазу "Қосынды 20-дан кіші немесе тең"
}

айнымалы санақ = 0
әзірше санақ < 5 {
    жазу санақ
    санақ = санақ + 1
}
